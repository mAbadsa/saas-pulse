generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MonitorStatus {
  PENDING
  UP
  DOWN
}

enum AlertChannelType {
  TELEGRAM
  SLACK
  DISCORD
  EMAIL
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  password      String
  monitors      Monitor[]
  alertChannels AlertChannel[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Monitor {
  id              String        @id @default(cuid())
  name            String
  url             String
  intervalSeconds Int           @default(60)
  isActive        Boolean       @default(true)
  status          MonitorStatus @default(PENDING)
  lastCheckedAt   DateTime?
  alertDownSince  DateTime? // non-null = a down alert is outstanding (value: when failures started)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks          Check[]
  alertLogs       AlertLog[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
}

model Check {
  id         String   @id @default(cuid())
  monitorId  String
  monitor    Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  isUp       Boolean
  statusCode Int? // null when the request failed or timed out
  latencyMs  Int?
  error      String? // timeout / DNS / connection error message
  checkedAt  DateTime @default(now())

  @@index([monitorId, checkedAt])
}

model AlertChannel {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AlertChannelType
  target     String? // Telegram chat id (legacy, for backward compatibility)
  webhookUrl String? // Slack/Discord webhook URL
  email      String? // Email recipient
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  logs       AlertLog[]

  @@unique([userId, type])
  @@index([userId])
}

model AlertLog {
  id              String   @id @default(cuid())
  monitorId       String
  monitor         Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  alertChannelId  String
  alertChannel    AlertChannel @relation(fields: [alertChannelId], references: [id], onDelete: SetNull)
  status          String   // UP, DOWN, PENDING
  channelType     AlertChannelType
  deliveryStatus  String   // SUCCESS, FAILED, RETRYING
  errorMessage    String?
  retryCount      Int      @default(0)
  timestamp       DateTime @default(now())
  completedAt     DateTime?

  @@index([monitorId, timestamp])
  @@index([alertChannelId, timestamp])
  @@index([deliveryStatus])
}
