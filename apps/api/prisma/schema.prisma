generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MonitorStatus {
  PENDING
  UP
  DOWN
}

enum AlertChannelType {
  TELEGRAM
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  password      String
  monitors      Monitor[]
  alertChannels AlertChannel[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Monitor {
  id              String        @id @default(cuid())
  name            String
  url             String
  intervalSeconds Int           @default(60)
  isActive        Boolean       @default(true)
  status          MonitorStatus @default(PENDING)
  lastCheckedAt   DateTime?
  alertDownSince  DateTime? // non-null = a down alert is outstanding (value: when failures started)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks          Check[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
}

model Check {
  id         String   @id @default(cuid())
  monitorId  String
  monitor    Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  isUp       Boolean
  statusCode Int? // null when the request failed or timed out
  latencyMs  Int?
  error      String? // timeout / DNS / connection error message
  checkedAt  DateTime @default(now())

  @@index([monitorId, checkedAt])
}

model AlertChannel {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AlertChannelType
  target    String // Telegram chat id
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, type])
}
