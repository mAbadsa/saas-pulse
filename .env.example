# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://user:password@localhost:5442/saas_pulse?schema=public"

# Redis (matches docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6389

# API
PORT=3000

# Web (Vite dev server)
VITE_API_URL=http://localhost:3000

# Auth
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=1d

# Ping service
PING_ENABLED=true
PING_ALLOW_PRIVATE=false   # true only for local dev (lets monitors reach localhost)
PING_TIMEOUT_MS=10000
